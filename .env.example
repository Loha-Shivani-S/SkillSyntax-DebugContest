# SYSTEM FAILURE — Environment Configuration
# Copy this file to .env or add these variables to your Vercel Project Settings

# Admin Authentication
ADMIN_PASSCODE="RECOVER-2026"
AUTH_SECRET="sysfailure-master-secret-2026"

# Optional: Supabase Connection (Recommended when deploying to Vercel)
# If left blank, the app runs with local in-memory/file storage
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional: Judge0 API (If you have a dedicated Judge0 instance)
# If left blank, the app uses the built-in isolated GCC sandbox (Wandbox)
JUDGE0_API_URL=""
JUDGE0_API_KEY=""
